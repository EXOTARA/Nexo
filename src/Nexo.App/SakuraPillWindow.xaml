<Window x:Class="Nexo.App.SakuraPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Visibility="Collapsed">
    <!--
        Diseño D4 — Sakura Pill Host. Ventana ambiental que muestra el ciclo de vida de una
        solicitud (Escuchando/Pensando/Resultado/Error) sin robar el foco de la ventana con la que
        el usuario está trabajando. Igual que CapsuleWindow, marca WS_EX_NOACTIVATE +
        WS_EX_TOOLWINDOW en OnSourceInitialized (code-behind); a diferencia de CapsuleWindow (un
        aviso transitorio que se autodescarta), esta ventana admite interacción real (Cancelar,
        Deshacer, acciones rápidas) mientras sigue sin activarse ni robar el foco.
    -->
    <Border x:Name="PillBorder"
            Padding="16,14"
            CornerRadius="22"
            Background="{DynamicResource BrushSurfaceRaised}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              ShadowDepth="8"
                              Opacity="0.38"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="30"
                        Height="30"
                        CornerRadius="15"
                        Background="{DynamicResource BrushAccentSoft}"
                        VerticalAlignment="Top">
                    <ContentControl Width="17"
                                    Height="17"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BrushAccent}"
                                    Style="{StaticResource KohanaFlowerMarkStyle}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,6,0">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Escuchando…"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock x:Name="ShortTextBlock"
                               Margin="0,3,0,0"
                               Text=""
                               FontSize="13.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock x:Name="ErrorTextBlock"
                               Margin="0,3,0,0"
                               Text=""
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushDanger}"
                               Visibility="Collapsed" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Top"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar la solicitud ambiental"
                        Click="CloseButton_Click">
                    <TextBlock Text="&#10005;" FontSize="11" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <TextBlock x:Name="ExpandedTextBlock"
                       Margin="44,8,0,0"
                       Text=""
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Visibility="Collapsed" />

            <StackPanel x:Name="QuickActionsPanel"
                        Margin="44,10,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed" />

            <StackPanel x:Name="FooterPanel"
                        Margin="44,10,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Button x:Name="ExpandToggleButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,4"
                        FontSize="12"
                        Click="ExpandToggleButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="UndoButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,4"
                        FontSize="12"
                        Content="Deshacer"
                        AutomationProperties.Name="Deshacer la última solicitud ambiental"
                        Click="UndoButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
