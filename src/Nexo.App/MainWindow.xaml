<Window x:Class="Nexo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kohana"
        Width="720"
        Height="790"
        MinWidth="680"
        MinHeight="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Closed="Window_Closed"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="HeaderCommandButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BrushFocusRing}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder"
            Margin="16"
            Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="28"
            Opacity="0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="8"
                              Opacity="0.4"
                              Color="Black" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShellTranslate" X="24" />
        </Border.RenderTransform>

        <Grid ClipToBounds="True">
            <Grid Margin="13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SideRailBorder"
                        Grid.Column="0"
                        Width="{DynamicResource SidebarWidthCollapsed}"
                        Margin="0"
                        Padding="7,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource BrushSidebarSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusShell}"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="4"
                                          Opacity="0.25"
                                          Color="Black" />
                    </Border.Effect>

                    <Grid x:Name="SideRailContentGrid" Width="52" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="SideRailToggleButton"
                                Style="{StaticResource SakuraSidebarToggleStyle}"
                                ToolTip="Expandir o contraer navegación"
                                AutomationProperties.Name="Expandir o contraer navegación"
                                Click="SideRailToggleButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource BrushAccentSoft}"
                                        BorderBrush="{DynamicResource BrushAccentBorder}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid Width="21" Height="21">
                                        <Path Data="{StaticResource IconSidebarPanel}"
                                              Style="{StaticResource SakuraNavigationIconStyle}"
                                              Stroke="{DynamicResource BrushAccent}" />
                                        <Path Data="M13.5,8 L17.5,12 L13.5,16"
                                              Width="7"
                                              Height="9"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Stretch="Fill"
                                              Stroke="{DynamicResource BrushAccent}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="SideRailChevronRotate"
                                                                 Angle="0"
                                                                 CenterX="3.5"
                                                                 CenterY="4.5" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="SideRailBrandText"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Kohana"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Tu Windows, en flor"
                                               Margin="0,2,0,0"
                                               Style="{StaticResource SakuraPageSubtitleStyle}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Row="1"
                                    x:Name="NavigationGrid"
                                    Margin="0,14,0,8"
                                    VerticalAlignment="Top">
                            <Button x:Name="HomeNavButton"
                                    Tag="Home"
                                    ToolTip="Inicio"
                                    AutomationProperties.Name="Inicio"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HomeNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="HomeNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaHome}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="HomeNavLabel" Text="Inicio" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="AssistantNavButton"
                                    Tag="Assistant"
                                    ToolTip="Asistente"
                                    AutomationProperties.Name="Asistente"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AssistantNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="AssistantNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaAssistant}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="AssistantNavLabel" Text="Chat" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="TasksNavButton"
                                    Tag="Tasks"
                                    ToolTip="Pendientes de hoy"
                                    AutomationProperties.Name="Pendientes de hoy"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="TasksNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="TasksNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaTasks}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="TasksNavLabel" Text="Hoy" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="FocusNavButton"
                                    Tag="Focus"
                                    ToolTip="Enfoque"
                                    AutomationProperties.Name="Enfoque"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="FocusNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="FocusNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaFocus}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="FocusNavLabel" Text="Enfoque" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="RoutinesNavButton"
                                    Tag="Routines"
                                    ToolTip="Rutinas"
                                    AutomationProperties.Name="Rutinas"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RoutinesNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="RoutinesNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaRoutines}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="RoutinesNavLabel" Text="Rutinas" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="AudioNavButton"
                                    Tag="Audio"
                                    ToolTip="Audio"
                                    AutomationProperties.Name="Audio"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AudioNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="AudioNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaAudio}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="AudioNavLabel" Text="Audio" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="CaptureNavButton"
                                    Tag="Capture"
                                    ToolTip="Captura"
                                    AutomationProperties.Name="Captura"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CaptureNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="CaptureNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaCapture}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="CaptureNavLabel" Text="Captura" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Button x:Name="SystemNavButton"
                                    Tag="System"
                                    ToolTip="Sistema"
                                    AutomationProperties.Name="Sistema"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource SakuraNavigationItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SystemNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                    <Path Grid.Column="1" x:Name="SystemNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaSystem}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="SystemNavLabel" Text="Sistema" FontSize="14" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Button Grid.Row="2"
                                x:Name="SettingsNavButton"
                                Tag="Settings"
                                ToolTip="Personalización y perfiles"
                                AutomationProperties.Name="Personalización y perfiles"
                                Click="SettingsButton_Click"
                                Style="{StaticResource SakuraNavigationItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SettingsNavIndicator" Grid.Column="0" Width="{DynamicResource NavigationIndicatorWidth}" Margin="0,6" CornerRadius="2" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" />
                                <Path Grid.Column="1" x:Name="SettingsNavIcon" Style="{StaticResource SakuraNavigationIconStyle}" Data="{StaticResource IconKohanaSettings}" />
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" x:Name="SettingsNavLabel" Text="Personalizar" FontSize="14" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="13,2,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="5,4,5,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="WorkspaceTitleText"
                                           Text="Inicio"
                                           MaxWidth="360"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SakuraPageTitleStyle}" />
                                <Border x:Name="WakeWordIndicator"
                                        Margin="11,1,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushSurfaceRaised}"
                                        CornerRadius="9"
                                        Visibility="Collapsed"
                                        ToolTip="La activación por voz escucha únicamente la frase configurada.">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource BrushSuccess}" />
                                        <TextBlock x:Name="WakeWordIndicatorText"
                                                   Text="Kohana atenta"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ResourceModeIndicator"
                                        Margin="8,1,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BrushSurfaceRaised}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ResourceModeDot"
                                                 Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource BrushWarning}" />
                                        <TextBlock x:Name="ResourceModeText"
                                                   Text="Equipo ocupado"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="WorkspaceSubtitleText"
                                       Margin="0,5,0,0"
                                       Text="Tu espacio de acciones y contexto"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource SakuraPageSubtitleStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="9"
                                    Height="9"
                                    Margin="0,0,11,0"
                                    Background="{DynamicResource BrushSuccess}"
                                    CornerRadius="5"
                                    ToolTip="Kohana está activa"
                                    AutomationProperties.Name="Kohana está activa" />
                            <Button x:Name="CommandPaletteButton"
                                    Width="42"
                                    Height="42"
                                    Padding="0"
                                    Style="{StaticResource HeaderCommandButtonStyle}"
                                    Click="CommandPaletteButton_Click"
                                    ToolTip="Abrir comandos · Ctrl + Espacio"
                                    AutomationProperties.Name="Abrir paleta de comandos">
                                <Grid Width="19" Height="19">
                                    <Path Data="{StaticResource IconCommandPalette}"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource BrushAccent}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="5,0,5,5"
                            Padding="17"
                            Style="{StaticResource SakuraShellCardStyle}">
                        <ContentControl x:Name="ModuleHost" />
                    </Border>

                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="ClockText" Text="—" />
                        <TextBlock x:Name="DateText" Text="—" />
                        <TextBlock x:Name="HeaderCpuText" Text="—" />
                        <TextBlock x:Name="HeaderMemoryText" Text="—" />
                        <TextBlock x:Name="HeaderGpuText" Text="—" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
