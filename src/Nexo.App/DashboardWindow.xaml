<Window x:Class="Nexo.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nexo.App.Views"
        Title="Kohana Panel"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        Diseño D44 — el cajón cuelga del borde de arriba: recto arriba, redondeado abajo. Redondear
        las cuatro esquinas lo convertiría en una tarjeta flotante, y entonces el gesto de sacarlo
        desde el borde dejaría de explicarse solo.

        El margen lateral e inferior es el sitio de la sombra. Sin él, Windows la recorta contra el
        borde de la ventana y queda un canto gris recto — el mismo defecto que ya se corrigió en el
        mando de volumen (D40).
    -->
    <Border x:Name="PanelBorder"
            Margin="34,0,34,34"
            Background="{DynamicResource BrushSidebarSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,34,34"
            Opacity="0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Border.RenderTransformOrigin>0.5,0</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PanelTranslate" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>

        <views:DashboardView x:Name="Dashboard" />
    </Border>
</Window>
