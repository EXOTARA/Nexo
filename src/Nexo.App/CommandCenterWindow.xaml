<Window x:Class="Nexo.App.CommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sakura Command Center"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="Centro de comandos de Kohana">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusShell}"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.42" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Campo de búsqueda -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Padding="13,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Width="17"
                          Height="17"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Data="{StaticResource IconCommandPalette}"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />

                    <Grid Grid.Column="1" Margin="11,0,0,0">
                        <TextBlock x:Name="SearchHintText"
                                   VerticalAlignment="Center"
                                   Text="Busca una acción…"
                                   FontSize="14"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                        <TextBox x:Name="SearchBox"
                                 Height="46"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 CaretBrush="{DynamicResource BrushAccent}"
                                 TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Buscar una acción"
                                 AutomationProperties.HelpText="Escribe para filtrar; usa las flechas para elegir y Enter para ejecutar." />
                    </Grid>

                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,3">
                        <TextBlock Text="Esc"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Resultados -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Margin="0,12,0,0"
                     MaxHeight="352"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Focusable="False"
                     MouseLeftButtonUp="ResultsList_MouseLeftButtonUp"
                     AutomationProperties.Name="Resultados">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemSurface"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusMedium}"
                                            Padding="12,10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemSurface"
                                                    Property="Background"
                                                    Value="{DynamicResource BrushSurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface"
                                                    Property="Background"
                                                    Value="{DynamicResource BrushAccentSoft}" />
                                            <Setter TargetName="ItemSurface"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource BrushAccentBorder}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ItemSurface" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <Border Margin="9,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource BrushSurfaceRaised}"
                                            CornerRadius="5"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Background="{DynamicResource BrushSurfaceRaised}"
                                    CornerRadius="5"
                                    Padding="7,3"
                                    Visibility="{Binding ShortcutVisibility}">
                                <TextBlock Text="{Binding Shortcut}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Estado vacío -->
            <TextBlock x:Name="EmptyStateText"
                       Grid.Row="1"
                       Margin="0,26,0,18"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       FontSize="13"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Text="No hay ninguna acción que coincida." />

            <!-- Pie con ayuda de teclado -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="2,10,2,0"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↑ ↓ elegir"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextTertiary}" />
                    <TextBlock Text="·"
                               Margin="9,0"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextTertiary}" />
                    <TextBlock Text="Enter ejecutar"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextTertiary}" />
                    <TextBlock Text="·"
                               Margin="9,0"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextTertiary}" />
                    <TextBlock Text="Esc cerrar"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextTertiary}" />

                    <TextBlock x:Name="StatusText"
                               Margin="16,0,0,0"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BrushWarning}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
