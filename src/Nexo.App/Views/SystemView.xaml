<UserControl x:Class="Nexo.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel>
                <TextBlock Text="Estado del equipo y de los servicios que Kohana mantiene en segundo plano."
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <UniformGrid Columns="2" Rows="2" Margin="-4,14,-4,8">
                <Border Style="{StaticResource SubtleCardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="CpuValueText" Text="—" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SubtleCardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="MemoryValueText" Text="—" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SubtleCardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="GpuValueText" Text="—" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuMemoryText" Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SubtleCardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="DISCO USADO" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="DiskValueText" Text="—" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Capacidad del equipo" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="HardwareCapabilitySummaryText"
                                       Margin="0,3,0,0"
                                       Text="Detectando la capacidad del equipo…"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <Button x:Name="HardwareCapabilityRefreshButton"
                                Grid.Column="1"
                                Content="Actualizar detección"
                                VerticalAlignment="Top"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="HardwareCapabilityRefreshButton_Click"
                                AutomationProperties.Name="Actualizar detección de capacidad del equipo" />
                    </Grid>

                    <UniformGrid Columns="2" Margin="-4,12,-4,0">
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="NIVEL" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityTierText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityCpuText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="NÚCLEOS" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityCoresText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="RAM TOTAL" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityRamText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="ARQUITECTURA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityArchitectureText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="GPU PREFERIDA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityGpuText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="MEMORIA GRÁFICA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityGraphicsMemoryText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="BATERÍA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HardwareCapabilityBatteryText" Margin="0,4,0,0" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock x:Name="HardwareCapabilityCompletenessText"
                               Margin="4,10,4,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="HardwareCapabilityReasonsText"
                               Margin="4,6,4,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="HardwareCapabilityMissingDataText"
                               Margin="4,4,4,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Plan adaptativo" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="AdaptiveEnginePlanSummaryText"
                                       Margin="0,3,0,0"
                                       Text="Calculando…"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="MODO" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="AdaptiveEnginePlanModeText" Text="—" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="AdaptiveEnginePlanConfidenceText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <ItemsControl x:Name="AdaptiveEnginePlanItemsControl" Margin="-4,10,-4,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CategoryLabel}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Solo recomendación"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushWarning}"
                                                       Visibility="{Binding RecommendationOnlyVisibility}" />
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding ConfiguredLine}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding ActiveLine}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding RecommendedLine}" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ReasonText}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding WarningText}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding WarningVisibility}"
                                                   Foreground="{DynamicResource BrushWarning}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Diseño D11 (Fase 4 — Adaptive Computer Optimization) -->
            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Optimización del equipo" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Kohana revisa tu hardware real y propone solo lo que ese hardware justifica. Nada se aplica sin que lo confirmes, y siempre se puede deshacer."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />

                    <WrapPanel Margin="0,11,0,0">
                        <Button Margin="0,0,7,7" Content="Jugar" Tag="Jugar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Programar" Tag="Programar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Editar video" Tag="EdicionVideo"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Videollamada" Tag="Videollamada"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Batería" Tag="Bateria"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                        <Button Margin="0,0,7,7" Content="Uso general" Tag="General"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationScenarioButton_Click" />
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="OptimizationUndoButton"
                                Margin="0,0,7,0"
                                Content="Deshacer la última optimización"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationUndoButton_Click" />
                        <Button Content="Ver historial"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OptimizationAuditButton_Click" />
                    </WrapPanel>

                    <TextBlock x:Name="OptimizationStatusText"
                               Margin="0,9,0,0"
                               Text="Elige para qué quieres optimizar y Kohana te enseñará el plan antes de tocar nada."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mayor uso de memoria" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="TopProcessNameText"
                                   Margin="0,5,0,0"
                                   Text="Esperando datos..."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="TopProcessMemoryText"
                               Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               FontSize="14" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kohana Runtime" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="Servicios locales, privacidad y rendimiento en una sola vista."
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Reiniciar voz"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RestartVoiceButton_Click" />
                            <Button Content="Diagnóstico"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DiagnosticsButton_Click" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="2" Margin="-4,12,-4,0">
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="VOZ" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeVoiceText" Margin="0,4,0,0" Text="Comprobando…" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="IA" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeAiText" Margin="0,4,0,0" Text="Desactivada" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="VISION" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeVisionText" Margin="0,4,0,0" Text="Activa bajo demanda" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="11" Background="{DynamicResource BrushSurfaceRaised}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="RENDIMIENTO" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="RuntimeModeText" Margin="0,4,0,0" Text="Normal" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="RuntimeDetailText"
                               Margin="4,9,4,0"
                               Text="Kohana está lista."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HealthText"
                               Text="Leyendo el equipo..."
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushSuccess}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Alt + Shift + A abre la vista Peek sin mostrar toda la barra."
                               TextWrapping="Wrap"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <TextBlock x:Name="UpdatedAtText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Bottom"
                           Style="{StaticResource MutedTextStyle}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
