<UserControl x:Class="Nexo.App.Views.FocusMiniTimer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!--
        Diseño D3.1 — mini temporizador global de Enfoque. Vive en el encabezado del shell (junto
        al botón del Command Center), visible en cualquier sección salvo la propia Enfoque, para no
        duplicar visualmente la vista completa. Solo presenta un FocusDisplayState y emite
        intenciones (OpenRequested/PauseRequested/ResumeRequested/FinishRequested); no conoce
        FocusManager ni MainWindow — eso es responsabilidad de FocusContinuityCoordinator.

        Cancelar no aparece aquí a propósito: el encargo exige que, si se incluye, requiera
        confirmación, y una acción de un solo clic en una franja compacta del encabezado no es el
        lugar para eso. Cancelar sigue disponible en FocusView y en el Command Center.
    -->
    <Border x:Name="RootBorder"
            Padding="9,6"
            Background="{DynamicResource BrushSurfaceRaised}"
            BorderBrush="{DynamicResource BrushAccentBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}"
            AutomationProperties.Name="Sesión de enfoque en curso">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="OpenButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Background="Transparent"
                    Padding="0"
                    BorderThickness="0"
                    ToolTip="Abrir Enfoque"
                    AutomationProperties.Name="Abrir Enfoque"
                    Click="OpenButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="15"
                          Height="15"
                          Stretch="Uniform"
                          Data="{StaticResource IconSakuraFocus}"
                          Stroke="{DynamicResource BrushAccent}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <TextBlock x:Name="LabelText"
                               Margin="7,0,0,0"
                               MaxWidth="120"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="Enfoque"
                               FontSize="{DynamicResource FontSizeFootnote}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ClockText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="00:00"
                               FontSize="{DynamicResource FontSizeFootnote}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <Border x:Name="PausedBadge"
                            Margin="7,0,0,0"
                            Padding="5,1"
                            Background="{DynamicResource BrushSurface}"
                            CornerRadius="5"
                            Visibility="Collapsed">
                        <TextBlock Text="EN PAUSA"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                    </Border>
                </StackPanel>
            </Button>

            <Button x:Name="PauseResumeButton"
                    AutomationProperties.Name="Pausar o reanudar el enfoque"
                    Margin="8,0,0,0"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Style="{StaticResource IconButtonStyle}"
                    Click="PauseResumeButton_Click">
                <TextBlock x:Name="PauseResumeGlyph"
                           Text="&#10074;&#10074;"
                           FontSize="{DynamicResource FontSizeCaption}"
                           HorizontalAlignment="Center" />
            </Button>

            <Button x:Name="FinishButton"
                    Margin="5,0,0,0"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Finalizar sesión de enfoque"
                    AutomationProperties.Name="Finalizar sesión de enfoque desde el mini temporizador"
                    Click="FinishButton_Click">
                <TextBlock Text="&#10003;" FontSize="{DynamicResource FontSizeFootnote}" HorizontalAlignment="Center" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
