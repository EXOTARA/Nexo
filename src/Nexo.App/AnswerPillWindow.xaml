<Window x:Class="Nexo.App.AnswerPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        Height="156"
        MinHeight="132"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <!--
        Diseño D40 — el margen deja sitio a la sombra dentro de la ventana. Sin él, una ventana del
        tamaño exacto del contenido recorta la sombra en recto y deja un canto gris a un lado, que
        es el defecto que se vio en el panel de mandos.
    -->
    <Border x:Name="PillBorder"
            Margin="30"
            Padding="16,14"
            CornerRadius="24"
            Background="{DynamicResource BrushSurfaceRaised}"
            BorderBrush="{DynamicResource BrushAccentBorder}"
            BorderThickness="1"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="10"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PillTranslate" Y="-14" />
            </TransformGroup>
        </Border.RenderTransform>

        <!--
            El contenido se mide con este StackPanel para calcular a qué altura crecer. Va anclado
            arriba: si se centrara, el texto ya escrito se desplazaría hacia abajo con cada trozo
            nuevo que llega, y leer algo que se mueve mientras se lee es peor que esperar.
        -->
        <Grid x:Name="ContentPanel" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderRow" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource BrushAccent}"
                                Style="{StaticResource KohanaFlowerMarkStyle}" />

                <TextBlock x:Name="QuestionText"
                           Grid.Column="1"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeFootnote}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="HintText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Text="Esc" />
            </Grid>

            <TextBlock x:Name="AnswerText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="{DynamicResource FontSizeCallout}"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushTextPrimary}" />

            <!--
                En su propia fila y no debajo del texto dentro de una pila: cuando la respuesta
                llenaba la píldora, este aviso quedaba fuera del recorte. Es decir, la única pista
                de que el texto seguía era justamente la que no se veía.
            -->
            <TextBlock x:Name="OpenInKohanaText"
                       Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource BrushAccent}"
                       Text="Pulsa aquí para verla completa en Kohana" />
        </Grid>
    </Border>
</Window>
